{
  "name": "codex-promenade",
  "version": "2.9.0",
  "private": true,
  "description": "Compagnon de bureau animé",
  "author": "MrsMega",
  "desktopName": "codex-promenade",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrsMega/Codex-companion.git"
  },
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --test test/*.test.js",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "fr.mrsmega.codexpromenade",
    "productName": "Codex Promenade",
    "afterPack": "./scripts/after-pack.js",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../Resources",
        "to": "sprites",
        "filter": [
          "*.png",
          "*.webp",
          "*.icns"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "MrsMega",
      "repo": "Codex-companion"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "../Resources/CodexPromenade.icns",
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../Resources/CodexPromenade.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "syncDesktopName": true,
      "icon": "../Resources/CodexPromenade-icon.png"
    }
  }
}
